// ============================================================================
// Neon Task Studio — Reference Showcase Written in Declarative NeonLang (.neon)
// Demonstrates 50%+ code reduction & 100% two-way Dart interoperability
// ============================================================================
module app.screens.task_studio

import "package:neon_framework/neon.dart"

@state activeCount: Int = 3
@state tasks: List<String> = ["Design NeonLang Compiler", "Build Cross-OS IPA & APK Packager", "Integrate Google Antigravity Agents"]

component TaskStudioScreen {
    route: "/tasks"

    view {
        Scaffold(title: "Neon Task Studio") {
            Column(padding: 16.dp, gap: 12.dp) {
                Text("Organize with Clarity & Momentum")
                    .font(size: 20, weight: .bold)
                    .color(#4F46E5)

                ForEach(tasks) -> item {
                    Card(elevation: 2) {
                        Row(align: .spaceBetween) {
                            Text(item)
                            Badge("Active")
                        }
                    }
                }

                Button("+ Add Quick Task") {
                    activeCount += 1
                }
                .padding(8.dp)
            }
        }
    }
}

